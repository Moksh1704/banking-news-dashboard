# Required for the YouTube news integration
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# Required for the Groq chat backend
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: override the frontend backend URL in local development
BANKING_NEWS_BACKEND_URL=http://127.0.0.1:8000
